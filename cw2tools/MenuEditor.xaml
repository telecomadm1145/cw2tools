<UserControl x:Class="cw2tools.MenuEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cw2tools"
        xmlns:localc="clr-namespace:cw2tools.CasioInternal"
        mc:Ignorable="d"
        Background="{StaticResource BackgroundColor}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="菜单编辑器" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" Foreground="{StaticResource HeadingColor}"/>

        <!-- Load Button -->
        <Button Grid.Row="0" Content="加载菜单数据" Click="Button_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,20"/>

        <!-- Scrollable Menu Items Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="MenuItemsControl" >
                <ItemsControl.ItemTemplate>
                    <!-- Template for each CMenu -->
                    <DataTemplate DataType="{x:Type localc:CMenu}">
                        <GroupBox Margin="0,0,0,20" Padding="10">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding id, StringFormat='菜单 ID: 0x{0:X4}'}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource HeadingColor}"/>
                                    <Button Tag="{Binding}" Click="Button_Click_2" Content="编辑菜单属性"
                                            Margin="20,0,0,0" Padding="10,4" FontSize="12"/>
                                </StackPanel>
                            </GroupBox.Header>

                            <StackPanel>
                                <!-- Header Row for Items -->
                                <Border Background="#E0E0E0" Padding="8,6" Margin="0,0,0,5" CornerRadius="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Key" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="Cond" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="2" Text="Text Ptr" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="3" Text="文本 (Local 0)" FontWeight="Bold" Margin="5,0,0,0"/>
                                        <TextBlock Grid.Column="4" Text="文本 (Local 1)" FontWeight="Bold" Margin="5,0,0,0"/>
                                        <TextBlock Grid.Column="5" Text="操作" FontWeight="Bold" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- ItemsControl for the Items within CMenu -->
                                <ItemsControl ItemsSource="{Binding Items}" HorizontalContentAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <!-- Template for each Item -->
                                        <DataTemplate DataType="{x:Type localc:Item}">
                                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="8,8" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding key, StringFormat={}0x{0:X4}}" VerticalAlignment="Center" FontFamily="Consolas"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding condition, StringFormat={}0x{0:X2}}" VerticalAlignment="Center" TextAlignment="Center" FontFamily="Consolas"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding text_ptr2, StringFormat={}0x{0:X4}}" VerticalAlignment="Center" TextAlignment="Center" FontFamily="Consolas"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding text_local0}" VerticalAlignment="Center" Margin="5,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding text_local1}" VerticalAlignment="Center" Margin="5,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="5" Tag="{Binding}" Click="Button_Click_1" Content="编辑"
                                                            Margin="10,0,0,0" Padding="12,4" VerticalAlignment="Center" FontSize="12"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>