<Window x:Class="cw2tools.CodeInjector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cw2tools"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="代码注入器" Height="500" Width="800"
        Background="{StaticResource BackgroundColor}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="C# 代码注入" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{StaticResource HeadingColor}"/>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
            <avalonEdit:TextEditor
                Name="textEditor"
                SyntaxHighlighting="C#"
                FontFamily="Consolas"
                FontSize="14"
                ShowLineNumbers="True"
                Background="White"/>
        </Border>
    </Grid>
</Window>