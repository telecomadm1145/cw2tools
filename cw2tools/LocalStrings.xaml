<Window x:Class="cw2tools.LocalStrings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cw2tools"
        mc:Ignorable="d"
        Title="LocalStrings" Height="500" Width="600"
        Background="{StaticResource BackgroundColor}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="本地字符串编辑器" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" Foreground="{StaticResource HeadingColor}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Lookup Table Group -->
                <GroupBox Header="查找表设置">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="语言字节查找表偏移:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="LUT" Margin="0,0,10,10"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="查找" Click="Button_Click" Padding="15,4" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="语言字节:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="LanguageCode" Text="0"/>
                    </Grid>
                </GroupBox>

                <!-- String Table Group -->
                <GroupBox Header="字符串表操作">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="字符串表偏移:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="StringLut" Margin="0,0,10,10"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="查表" Click="Button_Click_1" Padding="15,4" Margin="0,0,0,10"/>

                        <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Content="导出 CSV" Click="Button_Click_2" HorizontalAlignment="Stretch"/>
                    </Grid>
                </GroupBox>

                <!-- Import Group -->
                <GroupBox Header="导入操作">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="字符串池基址:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="StringsBase" Grid.Column="1"/>
                        </Grid>
                        <Button Content="导入 CSV（字符串池法）" Click="Button_Click_3" HorizontalAlignment="Stretch"/>
                        <!--<Button Content="导入 CSV（就地替换）" HorizontalAlignment="Left" Margin="0,10,0,0"/>-->
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>