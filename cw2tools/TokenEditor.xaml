<Window x:Class="cw2tools.TokenEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cw2tools"
        mc:Ignorable="d"
        Title="Token Editor" Height="600" Width="900"
        Background="{StaticResource BackgroundColor}">

    <DockPanel LastChildFill="True" Margin="10">
        <!-- Header -->
        <TextBlock DockPanel.Dock="Top" Text="Token 编辑器" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" Foreground="{StaticResource HeadingColor}"/>

        <!-- Buttons at the Top -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="自动搜索 (Load)" Click="SearchButton_Click" Padding="15,6" Margin="0,0,10,0"/>
            <Button Content="保存CSV (Save)" Click="SaveRefreshButton_Click" Padding="15,6"/>
        </StackPanel>

        <!-- Status Bar at the Bottom -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="5">
            <StatusBarItem>
                <TextBlock Text="{Binding DisplayTokens.Count, StringFormat={}{0} items loaded}" Foreground="{StaticResource TextColor}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="* = modified" Foreground="{StaticResource TextColor}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ListView filling the remaining space -->
        <ListView x:Name="TokenListView"
                  ItemsSource="{Binding DisplayTokens}"
                  Margin="0,0,0,0"
                  BorderThickness="1"
                  BorderBrush="{StaticResource BorderColor}"
                  AlternationCount="2">

            <ListView.Resources>
                <!-- Style for alternating row background -->
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                            <Setter Property="Background" Value="White"/>
                        </Trigger>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F9F9F9"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E3F2FD"/>
                            <Setter Property="BorderBrush" Value="#2196F3"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.Resources>

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Mod" Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayStatus}" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#E74C3C"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Code" Width="80">
                         <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CodePointHex}" FontFamily="Consolas"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Hex" Width="400">
                         <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TextHex}" FontFamily="Consolas" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Text" Width="250" DisplayMemberBinding="{Binding OriginalText}"/>

                    <GridViewColumn Header="Len" Width="50" DisplayMemberBinding="{Binding OriginalLength}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>