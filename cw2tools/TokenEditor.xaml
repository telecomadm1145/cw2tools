<Window x:Class="cw2tools.TokenEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cw2tools"
        mc:Ignorable="d"
        Title="Token Editor" Height="600" Width="800">
    <DockPanel LastChildFill="True">
        <!-- Buttons at the Top -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <Button Content="自动搜索 (Load)" HorizontalAlignment="Left" Click="SearchButton_Click" Margin="0,0,10,0" Padding="10,2"/>
            <Button Content="保存CSV (Save)" HorizontalAlignment="Left" Click="SaveRefreshButton_Click" Padding="10,2"/>
            <!-- Add a Refresh Button if needed -->
            <!-- <Button Content="刷新 (Refresh)" HorizontalAlignment="Left" Click="RefreshButton_Click" Margin="10,0,0,0" Padding="10,2"/> -->
        </StackPanel>

        <!-- Status Bar at the Bottom (Optional) -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <!-- Can bind this to a property showing number of items or status -->
                <TextBlock Text="{Binding DisplayTokens.Count, StringFormat={}{0} items loaded}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="* = modified"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ListView filling the remaining space -->
        <ListView x:Name="TokenListView"
                  ItemsSource="{Binding DisplayTokens}"
                Margin="5"
                  AlternationCount="2">
            <!-- For alternating row colors -->

            <ListView.Resources>
                <!-- Style for alternating row background -->
                <Style TargetType="{x:Type ListViewItem}">
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <!-- Style for highlighting modified rows (Optional) -->
                <Style TargetType="{x:Type TextBlock}" x:Key="ModifiedMarkerStyle">
                    <Setter Property="Foreground" Value="Red"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="ToolTip" Value="Modified"/>
                </Style>
            </ListView.Resources>

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Mod" Width="30">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Display '*' if modified -->
                                <TextBlock Text="{Binding DisplayStatus}" HorizontalAlignment="Center"/>
                                <!-- Optional: Use Style Trigger based on IsModified -->
                                <!--<TextBlock Text="*">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>-->
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Code" Width="80" DisplayMemberBinding="{Binding CodePointHex}"/>

                    <GridViewColumn Header="Hex" Width="400" DisplayMemberBinding="{Binding TextHex}"/>

                    <GridViewColumn Header="Text" Width="200" DisplayMemberBinding="{Binding OriginalText}"/>

                    <!-- Add more columns if needed, e.g., Original Length -->
                    <GridViewColumn Header="Len" Width="50" DisplayMemberBinding="{Binding OriginalLength}"/>

                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>