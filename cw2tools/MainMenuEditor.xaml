<Window x:Class="cw2tools.MainMenuEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="主菜单编辑器" Height="650" Width="800" MinHeight="600" MinWidth="500"
        Background="#F5F5F5" FontFamily="Microsoft YaHei">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="#333333" Margin="5,2"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980B9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1F618D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="主菜单编辑器" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#2C3E50"/>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0">
                    <!-- Base Addresses Group -->
                    <GroupBox Header="基础地址">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="图标基址:"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="MenuBase1Input" Text="????" Margin="0,0,8,0"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="文本纹理基址:" Margin="0,10,8,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="MenuBase2Input" Text="????" Margin="0,10,8,0"/>

                            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="自动查找" 
                                    HorizontalAlignment="Left" Click="Button_Click_11" Margin="0,12,0,0"/>
                        </Grid>
                    </GroupBox>

                    <!-- Selection & Preview Load Group -->
                    <GroupBox Header="选择与加载">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="图标索引:"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="IndexInput" Text="0" Width="100" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="语言:" Margin="0,10,8,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="LanguageInput" Text="1" Width="100" HorizontalAlignment="Left" Margin="0,10,0,0"/>

                            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="加载预览" 
                                    HorizontalAlignment="Left" Click="Button_Click_1" Margin="0,12,0,0"/>
                        </Grid>
                    </GroupBox>

                    <!-- Bitmap Offsets Group -->
                    <GroupBox Header="位图偏移">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="第0位位图偏移:"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="BitmapOffset0" Text="????" Margin="0,0,8,0"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="修改" Click="Button_Click_4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="第1位位图偏移:" Margin="0,10,8,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="BitmapOffset1" Text="????" Margin="0,10,8,0"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="修改" Click="Button_Click_3" Margin="0,10,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="文本位图偏移:" Margin="0,10,8,0"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="BitmapOffset2" Text="????" Margin="0,10,8,0"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="修改" Click="Button_Click_6" Margin="0,10,0,0"/>
                        </Grid>
                    </GroupBox>

                    <!-- Mode Group -->
                    <GroupBox Header="模式设置">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="模式:"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ModeInput" Text="??" Width="100" HorizontalAlignment="Left" Margin="0,0,8,0"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="修改" Click="Button_Click_2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="模式代码 (BL偏移):" 
                                      ToolTip="模式对应代码(BL addr 偏移)" Margin="0,10,8,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ModeCodeInput2" 
                                    Text="??????" Width="100" HorizontalAlignment="Left" Margin="0,10,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="模式代码 (直接):" Margin="0,10,8,0"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ModeCodeInput" Text="??????" 
                                    Width="100" HorizontalAlignment="Left" Margin="0,10,8,0"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="修改" Click="Button_Click_13" Margin="0,10,0,0"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>

                <!-- Right Column -->
                <StackPanel Grid.Column="1" Width="250" Margin="15,0,0,0">
                    <!-- Icon Count Group -->
                    <GroupBox Header="图标数量">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="当前数量地址:"/>
                                <TextBlock x:Name="IconCountTip" Text="" Foreground="#3498DB" FontWeight="Medium"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="IconCountInput" Text="?" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="修改" Click="Button_Click_12"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Preview Group -->
                    <GroupBox Header="预览">
                        <Border CornerRadius="4" Background="#E9E9E9" Padding="8" HorizontalAlignment="Center">
                            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="2">
                                <Image x:Name="PreviewImage" Height="128" Width="220" 
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" 
                                       Stretch="Uniform"/>
                            </Border>
                        </Border>
                    </GroupBox>

                    <!-- Export/Replace Group -->
                    <GroupBox Header="导出/替换">
                        <StackPanel>
                            <Button Content="导出 (64*28)" Click="Button_Click_8" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                            <Button Content="替换图标 (64*15)" Click="Button_Click_7" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                            <Button Content="替换文字 (64*13)" Click="Button_Click_9" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                            <Button Content="替换图标和文字 (64*28)" Click="Button_Click_10" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>